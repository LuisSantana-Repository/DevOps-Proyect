# ============================================================
# MONGODB ATLAS CONFIGURATION
# ============================================================
# Choose ONE of the following options:

# Option 1: Complete Connection String (Recommended)
# Copy your connection string from MongoDB Atlas and paste it here
# Replace <username>, <password>, and <database> with your actual values
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority&appName=YourApp

# Option 2: Individual Components (Alternative)
# If you prefer to construct the connection string from components:
DB_USER=YOUR_MONGODB_ATLAS_USERNAME
DB_PASSWORD=YOUR_MONGODB_ATLAS_PASSWORD
DB_HOST=YOUR_CLUSTER.mongodb.net
DB_NAME=YOUR_DATABASE_NAME
DB_OPTIONS=retryWrites=true&w=majority&appName=YourApp

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
NODE_ENV=production
PORT=3000

# JWT Authentication Secret Key
TOKEN_KEY=your-secret-jwt-key-here

# ============================================================
# DOCKER COMPOSE CONFIGURATION (for local MongoDB - optional)
# ============================================================
# Uncomment these if you want to use local MongoDB via Docker Compose
# MONGO_INITDB_ROOT_USERNAME=root
# MONGO_INITDB_ROOT_PASSWORD=example
# MONGO_INITDB_DATABASE=app

# ============================================================
# MONGODB ATLAS SETUP INSTRUCTIONS
# ============================================================
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Create a free cluster (M0 tier is free forever)
# 3. Create a database user:
#    - Go to Database Access
#    - Add New Database User
#    - Choose Password authentication
#    - Set username and password (use these for DB_USER and DB_PASSWORD)
#    - Grant "Atlas admin" or "Read and write to any database" role
#
# 4. Whitelist your IP address:
#    - Go to Network Access
#    - Add IP Address
#    - Either add your current IP or use 0.0.0.0/0 for all IPs (less secure)
#
# 5. Get your connection string:
#    - Go to Database > Connect
#    - Choose "Connect your application"
#    - Copy the connection string
#    - Replace <password> with your actual password
#    - Replace <database> with your database name (e.g., "app")
#    - Paste into MONGODB_URI above
#
# 6. Test your connection:
#    - Run: npm start
#    - Check console for "connected to db" message
#
# ============================================================
# EXAMPLES
# ============================================================
# Example with full connection string:
# MONGODB_URI=mongodb+srv://myuser:mypassword123@cluster0.abc123.mongodb.net/myapp?retryWrites=true&w=majority&appName=MyApp
#
# Example with individual components:
# DB_USER=myuser
# DB_PASSWORD=mypassword123
# DB_HOST=cluster0.abc123.mongodb.net
# DB_NAME=myapp
# DB_OPTIONS=retryWrites=true&w=majority&appName=MyApp
